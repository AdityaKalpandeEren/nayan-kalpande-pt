<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon_start">
    <target android:name="c1"><aapt:attr name="android:animation">
        <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:duration="320"
            android:interpolator="@android:interpolator/overshoot" />
    </aapt:attr></target>
    <target android:name="c2"><aapt:attr name="android:animation">
        <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:startOffset="150" android:duration="320"
            android:interpolator="@android:interpolator/overshoot" />
    </aapt:attr></target>
    <target android:name="c3"><aapt:attr name="android:animation">
        <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:startOffset="300" android:duration="320"
            android:interpolator="@android:interpolator/overshoot" />
    </aapt:attr></target>
    <target android:name="trend"><aapt:attr name="android:animation">
        <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:startOffset="420" android:duration="420"
            android:interpolator="@android:interpolator/fast_out_slow_in" />
    </aapt:attr></target>
    <target android:name="head"><aapt:attr name="android:animation">
        <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:startOffset="820" android:duration="160" />
    </aapt:attr></target>
</animated-vector>
